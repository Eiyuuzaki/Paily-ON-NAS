# 默认：让 git 自动处理换行符
* text=auto

# ─── 强制 LF（这些文件用 CRLF 会出问题）─────────────────────────────
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# ─── 二进制文件（不做换行符转换）──────────────────────────────────
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.mmdb      binary
*.exe       binary
