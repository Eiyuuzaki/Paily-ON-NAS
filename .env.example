# =====================================================================
# Paily ON NAS —— 环境变量示例
#
# 用法：
#   cp .env.example .env
#   # 修改下面的密钥（尤其是标 CHANGE_ME 的）
#   docker compose up -d
#
# 说明：
#   - 本文件面向 ARM NAS（8 核 / 8GB 内存左右）调优
#   - x86 用户可把并发参数提高，见文件末尾「x86 调优」一节
#   - 密钥可直接用 openssl rand -hex 24 生成
# =====================================================================

# ─── 基础 ──────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# 宿主暴露的订阅端口（客户端订阅地址：http://<NAS-IP>:21380/clash）
CORE_PORT=21380

# 管理界面端口（可选，只在启用 ui profile 时生效）
UI_PORT=21381

# ─── 数据库 ────────────────────────────────────────────────────────────
# PostgreSQL 密码（只在容器网络内使用，不映射到宿主）
# 生成：openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ─── 认证 ──────────────────────────────────────────────────────────────
# 管理员登录密码（Web 管理界面 / API 登录用）
# 内网自用可以用简单的；若要暴露到公网务必用强密码
# 生成：openssl rand -hex 16
PAILY_ADMIN_PASSWORD=CHANGE_ME_admin_password

# 服务间共享密钥：paily-fetch 上报节点、源提交器上报来源都用它
# 生成：openssl rand -hex 24
PAILY_SERVICE_SECRET=CHANGE_ME_service_secret

# JWT 签名密钥（至少 32 字符）
# 生成：openssl rand -hex 32
PAILY_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long

# 测活后端密钥（paily-check 用）
# ！重要！必须与 etc/core.yaml 的 checkers[0].secret 保持一致
# 因为 checkers 是列表，viper 无法用环境变量覆盖，只能写在配置文件里
# 生成：openssl rand -hex 24
CHECKER_SECRET=CHANGE_ME_checker_secret

# ─── 抓取服务（paily-fetch）──────────────────────────────────────────────
# 抓取轮次间隔（秒），10800 = 每 3 小时。免费源更新本就慢，不必太频繁
FETCH_INTERVAL=10800
# 并发下载订阅的 worker 数（ARM 小机器建议 8-16）
FETCH_CONCURRENCY=16
# 订阅下载使用的 User-Agent
FETCH_UA=clash-verge/v1.0.0

# ─── 测活服务（paily-check）──────────────────────────────────────────────
# 六字段 Cron：秒 分 时 日 月 周。默认每 2 小时一轮（测活是家宽上的主要连接来源）
CHECK_CRON=0 */2 * * * *

# 初筛并发。ARM 上实测 64 是安全上限
# ！注意！提到 128 会耗尽容器文件描述符（默认 ulimit 1024），
# 表现为测活进度卡死、CPU 掉到 0%。本项目已在 compose 里把 nofile 提到 65536，
# 但 ARM 的 CPU 也不适合太高并发，64 是性价比最好的点。
INITIAL_CONCURRENCY=64

# 初筛探测目标。！重要！用 http 不要用 https
# 实测 http 的存活率约为 https 的 2 倍（免费节点多为 TLS-in-TLS，https 探测过于苛刻）
INITIAL_PING_URL=http://www.gstatic.com/generate_204

# 单次探测超时（毫秒）
INITIAL_PING_TIMEOUT_MS=6000

# 初筛存活阈值（毫秒），延迟超过该值不再进入复筛
# 免费节点延迟普遍偏高，6000 比较合适；设太小会误杀
INITIAL_ALIVE_THRESHOLD_MS=6000

# 复筛 Ping 并发与超时
DEEP_PING_CONCURRENCY=24
DEEP_PING_TIMEOUT_MS=6000

# 复筛全超时的节点是否直接丢弃
DEEP_PING_FILTER_DEAD=true

# 地区检测模式：
#   native_api —— 内置模块，不需要下载 MMDB 文件（推荐，最省事）
#   mmdb       —— 需下载 MMDB 文件，精度更高但占空间
#   script     —— 用 JS 脚本查询，最灵活但最慢
GEO_MODE=native_api

# 下载测速（默认关闭，很吃带宽）
# 开启时还需在 etc/check.yaml 里设置 deep.speed.url
SPEED_ENABLED=false

# ─── 进度条（容器里建议关闭，否则日志会被刷屏）─────────────────────────
PROGRESS_BAR=false

# =====================================================================
# x86 / 高配机器调优建议
# ---------------------------------------------------------------------
# 上面是 ARM NAS（8 核）的安全值。如果你是 x86 且 CPU 充裕，可以调高：
#
#   INITIAL_CONCURRENCY=128      # ARM 64 → x86 128~256
#   DEEP_PING_CONCURRENCY=48     # ARM 24 → x86 48~96
#   FETCH_CONCURRENCY=32         # ARM 16 → x86 32
#   CHECK_CRON=0 */15 * * * *    # 30 分钟 → 15 分钟
#
# 调高后务必观察一轮：
#   docker compose logs -f check
# 如果进度卡住不动、CPU 掉到 0%，说明并发过高，降回去。
#
# 另外 ulimits.nofile 不要调低（compose 里已设为 65536），这是硬性要求。
# =====================================================================