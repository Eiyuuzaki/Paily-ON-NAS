# Paily ON NAS —— 测活后端配置
#
# 复制为 check.yaml 后使用：
#   cp etc/check.yaml.example etc/check.yaml
#
# 环境变量优先于本文件；docker-compose.yml 已注入 PAILY_CORE_URL 与各并发参数。
# 这里只保留必须写文件的项（尤其是 core.secret）。
#
# 注意：core.secret 必须与 etc/core.yaml 的 checkers[tag=local].secret
# 以及 .env 的 CHECKER_SECRET 三者完全一致。

core:
  # 容器网络内的主服务地址
  url: "http://core:21380"
  # ！必须与 etc/core.yaml 的 checkers[].secret 一致
  secret: "CHANGE_ME_checker_secret"

schedule:
  # 六字段 Cron：秒 分 时 日 月 周
  # ⚠️ 易错：*/N 要放在「时」位（第 3 段）才是每 N 小时。
  #    "0 */30 * * * *" 是每 30 分钟（*/30 落在「分」位），不是每 30 小时。
  #    "0 0 */2 * * *"  才是每 2 小时。
  #  docker-compose 的 CHECK_CRON 环境变量优先级高于本项。
  cron: "0 0 */2 * * *"

initial:
  # ⚠️ 必须用 https:// 而非 http://。
  # 上游注释曾称「http 比 https 存活率高约一倍」，但实测证明那是假存活：
  # http 走裸 HTTP 探测，节点出口可本地伪造 204 响应（流量不出国），
  # 产出「测速 54ms 却连 Google 都打不开」的假节点。
  # https 走 TLS 握手 + 证书校验，必须真实到达 Google 才能通过——
  # 存活数会变少，但每一个都真实可用（2026-10-25 实测验证）。
  ping_url: "https://www.gstatic.com/generate_204"
  ping_avg: 2
  ping_timeout_ms: 6000
  # 样本间睡眠（ms）。代码默认 1000，且睡眠发生在并发名额持有期内。
  # 曾在单次探测只要 1.5s 时占掉 40% 墙时（初筛 5.8 → 0.8 节点/秒）。
  # 改用 https 后超时是 6s，这 1s 不再是大头：2026-10-26 20:00 一轮
  # 198 节点初筛 32s、6.2 节点/秒。设 0 只能再省约 3s，不值得改。
  ping_gap_ms: 1000
  concurrency: 64
  alive_threshold_ms: 6000

deep:
  ping:
    # 不要抬到 64。整轮每 2 小时一次，59 个节点深测 44s 已经够用；
    # 并发再翻倍只是把这几十秒压短，家宽上却要多开一批连接。
    # docker-compose 注入的 DEEP_PING_CONCURRENCY 优先于本项。
    concurrency: 24
    # 不要改成 1。现在 5 次全部失败才记 latency=-1；改成 1 次后，
    # 一次超时就把初筛刚判活的节点改写成死。抖动也会变成 0，
    # 稳定性分人人满分，评分里这 30% 不再能区分节点。
    avg: 5
    ping_url: "https://www.gstatic.com/generate_204"
    timeout_ms: 6000
    gap_ms: 1000
    filter_dead_deep: true

  geo:
    # native_api：使用内置地区检测模块，不需要下载 MMDB 文件
    mode: "native_api"
    concurrency: 10
    fallback_legacy: true
    fallback_inbound: false
    retry: 2
    native_api:
      timeout_ms: 5000
      providers: ["cloudflare-trace", "ipwhois", "myip", "ip-api", "ip-sb"]

  script:
    # 本仓库未附带解锁检测脚本；把自写的 .js 放进 ./scripts 即可被加载
    dir: "/app/scripts"
    engine: "goja"
    node_concurrency: 5
    script_concurrency: 16
    timeout_ms: 10000
    regions: []
    scripts: []

  speed:
    # 下载测速默认关闭（占用带宽大）
    # 开启时把 enabled 设为 true 并填写 url
    enabled: false
    concurrency: 2
    threads: 4
    duration_s: 8
    url: "https://dl.google.com/developers/android/sc/images/factory/bramble-s3b1.220218.004-factory-a2a7cafb.zip"